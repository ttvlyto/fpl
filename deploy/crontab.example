# Sleeper EPL rankings: install with `crontab -e` on the server.
# Times are server local time. flock stops runs from overlapping.
# `;` (not &&) so the page is rebuilt from the last good data even if a fetch fails.
# Create the log directory first: mkdir -p /opt/sleeper_fpl/data
# Assumes the repo lives at /opt/sleeper_fpl; change the path if not.

# Daily: league, players, FPL bootstrap + fixtures
0 6 * * *     cd /opt/sleeper_fpl && flock -n /tmp/sleeperfpl.lock sh -c 'python3 -m sleeperfpl fetch-daily ; python3 -m sleeperfpl build' >> data/cron.log 2>&1

# Daily: FPL match history (no-op unless a new game week has finished), then refit the minutes model
# (fit-minutes skips itself when no new week is stored)
30 3 * * *    cd /opt/sleeper_fpl && flock -n /tmp/sleeperfpl.lock sh -c 'python3 -m sleeperfpl fetch-history ; python3 -m sleeperfpl fit-minutes ; python3 -m sleeperfpl build' >> data/cron.log 2>&1

# Every 4 hours: rosters + trending adds
0 */4 * * *   cd /opt/sleeper_fpl && flock -n /tmp/sleeperfpl.lock sh -c 'python3 -m sleeperfpl fetch-rosters ; python3 -m sleeperfpl build' >> data/cron.log 2>&1

# Thursdays, hourly from noon: rosters + trending before lineups are set
0 12-23 * * 4 cd /opt/sleeper_fpl && flock -n /tmp/sleeperfpl.lock sh -c 'python3 -m sleeperfpl fetch-rosters ; python3 -m sleeperfpl build' >> data/cron.log 2>&1

# Every 4 hours, and hourly on Thursday and Friday afternoons (press conferences):
# FPL injury flags and chances, which the minutes model's labels read. At :45 so it never
# shares a minute (and the lock) with matchday's :00/:30 runs.
45 */4 * * *  cd /opt/sleeper_fpl && flock -n /tmp/sleeperfpl.lock sh -c 'python3 -m sleeperfpl fetch-status ; python3 -m sleeperfpl build' >> data/cron.log 2>&1
45 12-23 * * 4,5 cd /opt/sleeper_fpl && flock -n /tmp/sleeperfpl.lock sh -c 'python3 -m sleeperfpl fetch-status ; python3 -m sleeperfpl build' >> data/cron.log 2>&1

# Every 2 hours: Kalshi + Polymarket match odds
15 */2 * * *  cd /opt/sleeper_fpl && flock -n /tmp/sleeperfpl.lock sh -c 'python3 -m sleeperfpl fetch-markets; python3 -m sleeperfpl build' >> data/cron.log 2>&1

# Match days (Fri-Mon), every 30 minutes: does nothing unless a match kicks off within
# matchday_window_hours or just finished; then refreshes lineups, odds, player markets, live stats
*/30 * * * 5,6,0,1 cd /opt/sleeper_fpl && flock -n /tmp/sleeperfpl.lock python3 -m sleeperfpl matchday >> data/cron.log 2>&1
