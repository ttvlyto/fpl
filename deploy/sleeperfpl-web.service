# Serves the generated page on the home network at http://<server>:8080/
# Install: sudo cp deploy/sleeperfpl-web.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now sleeperfpl-web
# Keep port 8080 closed on your router so it is not reachable from the internet.
[Unit]
Description=Sleeper EPL rankings page
After=network.target

[Service]
ExecStart=/usr/bin/python3 -m http.server 8080 --directory /opt/sleeper_fpl/site --bind 0.0.0.0
Restart=always
User=nobody

[Install]
WantedBy=multi-user.target
